# Copy this file to rag/.env and fill in the real value.
#
#   rag/.env          holds the real key  -> gitignored, never committed
#   rag/.env.example  holds this template -> committed, so the next person
#                                            knows which variables exist
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which backend answers. "ollama" = local, private, ~71s per answer.
# "gemini" = hosted, needs the key above, a few seconds per answer.
# Leave these unset to use the defaults in config.py (both "ollama").
#RAG_LLM_BACKEND=gemini

# Leave embedding on ollama unless you re-run `python rag/ingest.py` right
# after changing it - an index built by one model cannot be queried by another.
#RAG_EMBED_BACKEND=ollama
