# ==============================================================================
# Smart Healthcare — Root .gitignore
# Covers: React (Vite/TS), Spring Boot (Java/Maven), Python (RAG/Chroma), and OS
# ==============================================================================

# --- Secrets & Environment Configurations ---
# API keys, database credentials, JWT secrets (must never be committed)
.env
.env.*
*.env
!.env.example
!.env.*.example

# --- Dependencies & Package Managers ---
node_modules/
**/node_modules/
.pnp
.pnp.js

# --- Build Outputs & Artifacts ---
# Frontend (Vite / React)
dist/
dist-ssr/
build/
.eslintcache
.stylelintcache

# Backend (Maven / Spring Boot / Java)
target/
**/target/
*.class
*.war
*.ear
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# --- Python & AI / RAG Service ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.venv
rag/data/chroma/
**/chroma/
.pytest_cache/
.coverage
htmlcov/
*.ipynb_checkpoints/

# --- Logs & Runtime Data ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & Archives ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*.bak
*.zip
*.tar.gz
*.rar
*.7z

# --- Database Local Files & Machine Dumps ---
*.mdf
*.ldf
restart_sql.bat

# --- IDE & Editor Settings (User-specific) ---
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- AI Assistants & Tool Configs ---
context.md
.cursorrules
.claude/
.gemini/
.antigravity/
.cursor/
