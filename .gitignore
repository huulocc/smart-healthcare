# Project context and rules
context.md
.cursorrules

# Local Claude Code tool config
.claude/

# Secrets. These hold API keys and database passwords - committing one means
# revoking the key, because deleting the commit does not unpublish it.
# A pattern without a slash matches at any depth, so backend/.env and rag/.env
# are both covered.
.env
.env.*
*.env
!.env.example
!.env.*.example
