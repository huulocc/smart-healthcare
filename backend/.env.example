# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Optional: change only if port 8080 is already used on your machine
SERVER_PORT=8080

# ---------------------------------------------------------------------------------------
# SQL Server
#
# Three things have to be true on the instance before the backend can reach it at all, and
# none of them is on by default in a plain SQL Server Developer install. Set them in SQL
# Server Configuration Manager and SSMS, then restart the SQL Server service:
#
#   1. TCP/IP enabled. Configuration Manager -> SQL Server Network Configuration ->
#      Protocols for <INSTANCE> -> TCP/IP -> Enabled = Yes. A fresh install often leaves
#      only Shared Memory on, which is why sqlcmd and SSMS connect happily while the
#      backend cannot: the JDBC driver speaks TCP and nothing else.
#   2. A port the driver can name. See DB_URL below.
#   3. SQL Server authentication. SSMS -> right-click the server -> Properties -> Security
#      -> "SQL Server and Windows Authentication mode". Windows-only mode is the default,
#      and then the username/password below cannot be used. With it on, create the login:
#
#        CREATE LOGIN healthcare WITH PASSWORD = '<pick one>', CHECK_POLICY = OFF;
#        USE SmartHealthcareDB;
#        CREATE USER healthcare FOR LOGIN healthcare;
#        ALTER ROLE db_owner ADD MEMBER healthcare;   -- Flyway creates and alters tables
#
#      db_owner is deliberate: Flyway owns the schema, so it needs DDL rights, not just
#      read and write. Windows authentication works too, but it needs the driver's native
#      DLL on java.library.path, which every teammate would have to install separately --
#      a SQL login is the portable choice for a shared project.
#
# DB_URL: leave it unset to use the default in application.properties, which is
#   jdbc:sqlserver://localhost:1433;databaseName=SmartHealthcareDB;encrypt=true;trustServerCertificate=true
#
# That default assumes a *static* port. A named instance (anything other than MSSQLSERVER)
# listens on a port it picks again at every start, so one of these two has to be arranged:
#
#   a) Fix the port, and keep the default URL. Configuration Manager -> TCP/IP ->
#      Properties -> IP Addresses -> IPAll: TCP Dynamic Ports empty, TCP Port = 1433.
#      Port 1433 is free unless a default instance is also running.
#   b) Address the instance by name, and let the driver ask which port it is on today.
#      This needs the "SQL Server Browser" service running (it is usually stopped):
#      DB_URL=jdbc:sqlserver://localhost;instanceName=LOCALHOST;databaseName=SmartHealthcareDB;encrypt=true;trustServerCertificate=true
#
# (a) is the better default: one less service to keep running, and the URL stays the same
# on every machine. (b) is for when something else already owns 1433.
#DB_URL=
DB_USERNAME=healthcare
DB_PASSWORD=healthcare

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Gmail address + 16-character Google App Password (NOT your normal Gmail password).
# Leave empty to print password reset and activation links to the console instead of sending emails.
MAIL_USERNAME=
MAIL_PASSWORD=

# "Continue with Google". Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials with http://localhost:5173 as an
# authorised JavaScript origin, then paste the same value here and in frontend/.env.local
# as VITE_GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# The first admin account, created the first time the backend starts with these set, then
# never touched again. There is no sign-up path for admins on purpose, so this is the only
# way to get one. Leave blank to skip. Pick a real password -- not "admin" -- because this
# account can manage every doctor and patient. At least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
