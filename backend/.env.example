# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Optional: change only if port 8080 is already used on your machine
SERVER_PORT=8080

# Must match docker-compose.yml
DB_USERNAME=healthcare
DB_PASSWORD=healthcare

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Gmail address + 16-character Google App Password (NOT your normal Gmail password).
# Leave empty to print password reset links to the console instead of sending emails.
MAIL_USERNAME=
MAIL_PASSWORD=
