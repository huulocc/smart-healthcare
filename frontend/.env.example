# Copy to frontend/.env.local and keep only the lines you need. .env.local is never committed.

# Only if your backend does not run on the default port 8080.
API_PROXY_TARGET=http://localhost:8080

# "Continue with Google". Same OAuth Client ID as GOOGLE_CLIENT_ID in backend/.env.
# Create it at https://console.cloud.google.com/apis/credentials (type: Web application)
# with http://localhost:5173 as an authorised JavaScript origin.
# Leave this out to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
