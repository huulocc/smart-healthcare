{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:booking": "rolldown tests/booking.test.ts --platform node -f esm -o node_modules/.tmp/booking-tests.mjs && node node_modules/.tmp/booking-tests.mjs",
    "test:doctor": "rolldown tests/doctor.test.ts --platform node -f esm -o node_modules/.tmp/doctor-tests.mjs && node node_modules/.tmp/doctor-tests.mjs",
    "test:aiUsage": "rolldown tests/aiUsage.test.ts --platform node -f esm -o node_modules/.tmp/aiUsage-tests.mjs && node node_modules/.tmp/aiUsage-tests.mjs",
    "prepare": "husky",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm lint:fix",
      "pnpm format",
      "git add ."
    ]
  }
}
